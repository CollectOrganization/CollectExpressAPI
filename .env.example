# Banco e autenticação
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

PORT=3001
FRONTEND_URL=http://localhost:3000

# URL pública desta API (fotos em /uploads e link do e-mail de extensão).
# No Render, se ficar vazia, usa RENDER_EXTERNAL_URL automaticamente.
PUBLIC_API_URL=http://localhost:3001

# Pasta dos arquivos enviados (padrão: ./storage)
# UPLOADS_DIR=

# Pagamento PIX (AbacatePay)
ABACATEPAY_API_KEY=

# E-mail: sem BREVO_API_KEY o driver "console" só registra no log.
# EMAIL_DRIVER=brevo
BREVO_API_KEY=
EMAIL_FROM=collectexpress.app@gmail.com
EMAIL_FROM_NAME=Collect Express

# Segredo do cron externo que chama POST /api/internal/jobs/extensoes
# (header x-jobs-secret). Vazio = rota desativada.
JOBS_SECRET=
