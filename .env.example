# Banco e autenticação
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

PORT=3001
FRONTEND_URL=http://localhost:3000

# URL pública desta API (fotos em /uploads e link do e-mail de extensão).
# No Render, se ficar vazia, usa RENDER_EXTERNAL_URL automaticamente.
PUBLIC_API_URL=http://localhost:3001

# Pasta dos arquivos enviados (padrão: ./storage)
# UPLOADS_DIR=

# Pagamento PIX (AbacatePay)
ABACATEPAY_API_KEY=

# E-mail: sem BREVO_API_KEY o driver "console" só registra no log.
# EMAIL_DRIVER=brevo
BREVO_API_KEY=
EMAIL_FROM=collectexpress.app@gmail.com
EMAIL_FROM_NAME=Collect Express

# Segredo do cron externo que chama POST /api/internal/jobs/extensoes
# (header x-jobs-secret). Vazio = rota desativada.
JOBS_SECRET=
# Cerca virtual: o Nominatim (OpenStreetMap) exige identificar quem consulta.
# Informe um e-mail ou site de contato. Limite de 1 consulta por segundo.
GEOCODING_CONTACT=
# NOMINATIM_MIN_INTERVAL_MS=1100
# Segredo do código de autenticação do termo de coleta de reciclagem.
# Vazio = usa JWT_SECRET (trocar o segredo invalida a verificação dos termos já emitidos).
DOCUMENT_SIGNING_SECRET=
# Logs de erros (tabela logs_erros). Padrões: 30 dias de retenção, ligado.
# LOGS_RETENCAO_DIAS=30
# LOGS_DESATIVADOS=false

# Limite geral de requisições por IP por minuto (padrão 300).
# GLOBAL_RATE_LIMIT=300

# Análise do CNPJ com IA (PLN) na aprovação de fornecedores.
# Usa a Groq (plano gratuito): crie a chave em console.groq.com/keys.
# Sem chave, a análise roda só com as regras e pede conferência manual da atividade.
GROQ_API_KEY=
# ANALISE_CNPJ_MODELO=openai/gpt-oss-120b
# ANALISE_CNPJ_IA=false          (desliga o LLM)
# ANALISE_CNPJ_NO_CADASTRO=false (não analisa sozinho ao cadastrar)
